# Copy to .env, then set the provider URL and a model available to your account.
# Hosted example base URL: https://api.openai.com/v1
# Ollama on this Mac: http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional imported snapshot path INSIDE the container; blank uses synthetic data.
NETWORK_DB_PATH=
